{
  "formatVersion": 1,
  "guidEncoding": {
    "name": ".NET Guid byte representation",
    "exampleUuid": "00112233-4455-6677-8899-aabbccddeeff",
    "exampleHex": "33221100554477668899aabbccddeeff"
  },
  "protocols": [
    {
      "name": "realtime",
      "endpoint": "/ws/v1/realtime",
      "clientToServer": [
        {
          "name": "gamePayload",
          "offset": 0,
          "type": "bytes"
        }
      ],
      "serverToClient": [
        {
          "name": "senderParticipantId",
          "offset": 0,
          "length": 16,
          "type": "guid-dotnet"
        },
        {
          "name": "gamePayload",
          "offset": 16,
          "type": "bytes"
        }
      ],
      "clientFrameMaxBytes": 8192,
      "defaultMessagesPerSecond": 30,
      "routing": "Guest frames go only to host; host frames go to other connected participants."
    },
    {
      "name": "voice",
      "endpoint": "/ws/v1/voice",
      "clientToServer": [
        {
          "name": "audio",
          "offset": 0,
          "type": "bytes"
        }
      ],
      "serverToClient": [
        {
          "name": "senderUserId",
          "offset": 0,
          "length": 16,
          "type": "guid-dotnet"
        },
        {
          "name": "audio",
          "offset": 16,
          "type": "bytes"
        }
      ],
      "clientFrameMaxBytes": 4000,
      "defaultPacketsPerSecond": 100,
      "routing": "Audio goes to other connected non-deafened participants; own-muted and server-muted senders are dropped."
    },
    {
      "name": "relay",
      "endpoint": "/ws/v1/relay",
      "clientToServer": [
        {
          "name": "gamePayload",
          "offset": 0,
          "type": "bytes"
        }
      ],
      "serverToClient": [
        {
          "name": "gamePayload",
          "offset": 0,
          "type": "bytes"
        }
      ],
      "defaultFrameMaxBytes": 4096,
      "routing": "Payload is unchanged; no sender prefix. Match roster authorizes membership. Pace frames to the bound match rate."
    },
    {
      "name": "container-stream",
      "endpoint": "/stream",
      "platformToContainer": [
        {
          "name": "type",
          "offset": 0,
          "length": 1,
          "value": 1
        },
        {
          "name": "sessionId",
          "offset": 1,
          "length": 16,
          "type": "guid-dotnet"
        },
        {
          "name": "userId",
          "offset": 17,
          "length": 16,
          "type": "guid-dotnet"
        },
        {
          "name": "commandData",
          "offset": 33,
          "type": "utf8-json"
        }
      ],
      "containerToPlatform": [
        {
          "name": "type",
          "offset": 0,
          "length": 1,
          "value": 2
        },
        {
          "name": "sessionId",
          "offset": 1,
          "length": 16,
          "type": "guid-dotnet"
        },
        {
          "name": "userId",
          "offset": 17,
          "length": 16,
          "type": "guid-dotnet"
        },
        {
          "name": "gameData",
          "offset": 33,
          "type": "utf8-json"
        }
      ],
      "broadcastUserId": "00000000-0000-0000-0000-000000000000"
    },
    {
      "name": "game-upload",
      "endpoint": "/ws/v1/game-upload",
      "clientToServer": [
        {
          "name": "archiveChunk",
          "offset": 0,
          "type": "bytes"
        }
      ],
      "content": "Binary frames concatenate into a gzip tar archive. Send complete as a JSON text frame after all bytes; no publication occurs without complete."
    }
  ]
}
